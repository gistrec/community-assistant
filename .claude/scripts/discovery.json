    "alembic",
    "httpx",
    "\"docker compose\" error",
    "nginx proxy",
    "cloudflare dns",
    "boto3 s3"
  ],
  "repo_searches": [
    "topic:cpp language:C++",
    "topic:cmake language:CMake",
    "topic:cmake language:C++",
    "topic:header-only language:C++",
    "topic:pybind11 language:C++",
    "topic:vcpkg language:CMake",
    "topic:conan language:Python",
    "topic:python language:Python",
    "topic:packaging language:Python",
    "topic:github-actions language:TypeScript",
    "topic:gis language:C++",
    "topic:geospatial language:Python",
    "topic:mcp language:Python",
    "topic:mcp-server language:TypeScript",
    "topic:fastapi language:Python",
    "topic:pydantic language:Python",
    "topic:sqlalchemy language:Python",

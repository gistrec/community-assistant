  "repos_per_search": 5,
  "max_discovered_repos": 40,
  "exclude_repos": [
    "fastapi/fastapi",
    "sqlalchemy/sqlalchemy"
  ],
  "skip_category_patterns": [
    "announcement",
    "general",
    "show and tell",
    "show-and-tell",
    "issue triage",
    "potential issue",
    "bug",
    "feature",
    "idea",
    "proposal",
    "rfc",
    "request script"
  ],
  "skip_title_rules": [
    {

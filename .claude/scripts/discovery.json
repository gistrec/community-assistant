{
  "keywords": [
    "cmake",
    "vcpkg",
    "conan",
    "pybind11",
    "cpp",
    "c++",
    "modern c++",
    "python packaging",
    "pyproject",
    "setuptools",
    "poetry",
    "github actions",
    "\"mcp server\"",
    "fastmcp",
    "\"model context protocol\"",
